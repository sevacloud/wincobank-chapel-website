{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/npm-audit-gate.mjs\"",
            "timeout": 120,
            "statusMessage": "Running npm audit before commit…"
          }
        ]
      }
    ]
  }
}
